{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "health-circlejtp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-30",
  "observability": { "enabled": true },

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker runs first so it can add security headers and resolve the brand
    // file out of R2 rather than from the deployed assets.
    "run_worker_first": true
  },

  // The Epic brand directory lives in R2, not in the deploy, so the weekly refresh
  // job can replace it without shipping a new Worker version. It is also far too
  // large to be a static asset uncompressed (~47 MB against a 25 MiB limit).
  "r2_buckets": [
    { "binding": "BRANDS", "bucket_name": "health-circlejtp-brands" }
  ],

  "triggers": {
    // Weekly refresh of the Epic brand directory. See docs/health.circlejtp.me-plan.md §5.
    "crons": ["0 6 * * SUN"]
  },

  "routes": [
    { "pattern": "health.circlejtp.me", "custom_domain": true }
  ],

  // EPIC_CLIENT_ID is set as a Worker secret, not here:
  //   npx wrangler secret put EPIC_CLIENT_ID
  // It is not a secret in the cryptographic sense - a SMART public client cannot hold
  // one, and this value appears in the bundle and in every authorize URL. Keeping it
  // out of the committed config stops a fork from shipping our registration and having
  // its users' authorizations attributed to us by Epic. The value of record lives in
  // 1Password: Employee -> Epic -> Production Client ID.
  //
  // PREVIEW_TOKEN is deliberately absent. It gated the retriever before launch; with
  // EPIC_CLIENT_ID set, retrieverAllowed() returns true for everyone and the token
  // granted nothing extra. Removing it means the committed value - public in git
  // history - cannot be presented as a bypass of anything. Do not reintroduce that
  // value; generate a new one if a gate is ever needed again.
}
